#!/usr/bin/env bash

# START
set -e

# VARIABLES
URL_DNS_LIST="https://pgl.yoyo.org/adservers/serverlist.php?showintro=0&mimetype=plaintext"
NAME_OSX="Darwin"
THIS_OS=$(uname -mrs)
PROGNAME=$(basename "$0")

# CORRECCIÓN: Obtener el directorio HOME del usuario real, incluso si se usa sudo
if [ -n "$SUDO_USER" ]; then
    REAL_HOME=$(eval echo ~$SUDO_USER)
else
    REAL_HOME=$HOME
fi

[[ -z "${XDG_CONFIG_HOME}" ]] && CONFIG="$REAL_HOME/.maza/" || CONFIG="$XDG_CONFIG_HOME/maza/"
HOST_FILE=/etc/hosts
COLOR_RED=$(tput setaf 1)
COLOR_GREEN=$(tput setaf 2)
COLOR_RESET=$(tput sgr0)
LIST="list"
LIST_DNSMASQ="dnsmasq.conf"
IGNORE_LIST_FILE="ignore"
ADDING_LIST_FILE="blocking"
START_TAG="## MAZA - List ad blocking"
PROJECT="### https://github.com/tanrax/maza-ad-blocking"
AUTHOR="### Created by Andros Fenollosa (https://andros.dev/)"
END_TAG="## END MAZA"

# PASO 2: INICIALIZACIÓN EN LA PRIMERA EJECUCIÓN
if [ ! -d "$CONFIG" ]; then
    mkdir -p "$CONFIG"
    touch "$CONFIG/$ADDING_LIST_FILE"
    touch "$CONFIG/$IGNORE_LIST_FILE"
    echo "address=/.localhost/127.0.0.1" > "$CONFIG/$LIST_DNSMASQ"
    echo "${COLOR_GREEN}Primera ejecución detectada. Directorio de configuración creado en $CONFIG${COLOR_RESET}"
fi

# Create sed cross system
custom-sed() {
    if [[ $THIS_OS = *$NAME_OSX* ]]; then
        # Check if OSX and install GSED
        if [ -x "$(command -v gsed)" ]; then
            gsed "$@"
        else
            echo "${COLOR_RED}ERROR. You must install gsed if you are using OSX${COLOR_RESET}"
            exit 1
        fi
    else
        # Linux
        sed "$@"
    fi
}
export -f custom-sed

# FUNCTIONS

## HELP
usage() {
    if [ "$*" != "" ] ; then
        echo "Error: $*"
    fi

    cat << EOF
Usage: $PROGNAME [OPTION]
Simple and efficient local ad blocking throughout the network.

Options:
  status             Check if it's active or not
  update             Update the list of DNS to be blocked
  start              Activate blocking DNS.
  stop               Stop blocking DNS.
  autostart          Enable autostart on system boot (macOS).
  disableautostart   Disable and remove autostart service.
  --help             Display this usage message and exit
EOF

    exit 1
}

status() {
    if grep -qF "$START_TAG" "$HOST_FILE";then
        echo "${COLOR_GREEN}ENABLED${COLOR_RESET}"
    else
        echo "${COLOR_RED}DISABLED${COLOR_RESET}"
    fi
}

update() {
    # Make conf folder
    rm -f "$CONFIG$LIST"
    rm -f "$CONFIG$LIST_DNSMASQ"
    mkdir -p "$CONFIG"
    # Download DNS list
    curl -L -s "$URL_DNS_LIST" -o "$CONFIG$LIST"
    # Clear list
    ## Remove comments
    custom-sed -i.bak '/^#/ d' "$CONFIG$LIST"
    ## Remove empty lines
    custom-sed -i.bak '/^[[:space:]]*$/ d' "$CONFIG$LIST"
    ## Remove lines that don't start with "127.0.0.1 " (for dnsmasq processing)
    custom-sed -i.bak '/^127\.0\.0\.1 /! d' "$CONFIG$LIST"
    
    # Make dnsmasq format
    ## 127.0.0.1 doubleclick.net to address=/doubleclick.net/127.0.0.1
    cp "$CONFIG$LIST" "$CONFIG$LIST_DNSMASQ"
    custom-sed -i.bak 's/127.0.0.1 /address=\//g' "$CONFIG$LIST_DNSMASQ"
    custom-sed -i.bak 's/$/\/127.0.0.1/g' "$CONFIG$LIST_DNSMASQ"
    
    ## Add start tag DNS list in first line
    custom-sed -i.bak "1i$AUTHOR" "$CONFIG$LIST"
    custom-sed -i.bak "1i$PROJECT" "$CONFIG$LIST"
    custom-sed -i.bak "1i$START_TAG" "$CONFIG$LIST"
    
    # Remove the domains to ignore. They are located in ".maza/ignore"
    if [ -f "$CONFIG/$IGNORE_LIST_FILE" ]; then
        while IFS= read -r domain || [ -n "$domain" ]; do
            domain="${domain//$'\r'/}"
            [[ -z "$domain" || "$domain" =~ ^[[:space:]]*# ]] && continue
            custom-sed -i.bak "/$domain/d" "$CONFIG$LIST"
            custom-sed -i.bak "/$domain/d" "$CONFIG$LIST_DNSMASQ"
        done < "$CONFIG/$IGNORE_LIST_FILE"
    fi

    # PASO 1: Añadir dominios personalizados a bloquear
    if [ -f "$CONFIG/$ADDING_LIST_FILE" ]; then
        while IFS= read -r domain || [ -n "$domain" ]; do
            domain="${domain//$'\r'/}"
            [[ -z "$domain" || "$domain" =~ ^[[:space:]]*# ]] && continue
            echo "127.0.0.1 $domain" >> "$CONFIG$LIST"
            echo "address=/$domain/127.0.0.1" >> "$CONFIG$LIST_DNSMASQ"
        done < "$CONFIG/$ADDING_LIST_FILE"
    fi

    # Asegurar que el bloqueo de sub-dominios localhost persista
    echo "address=/.localhost/127.0.0.1" >> "$CONFIG$LIST_DNSMASQ"

    ## Add end tag DNS list
    echo "$END_TAG" >> "$CONFIG/$LIST"
    ## Add start tag DNS dnsmasq
    custom-sed -i.bak "1i$AUTHOR" "$CONFIG$LIST_DNSMASQ"
    custom-sed -i.bak "1i$PROJECT" "$CONFIG$LIST_DNSMASQ"
    custom-sed -i.bak "1i$START_TAG" "$CONFIG$LIST_DNSMASQ"
    ## Add end tag DNS DNSMASQ
    echo "$END_TAG" >> "$CONFIG$LIST_DNSMASQ"
    
    # Remove temp file
    rm -f "$CONFIG$LIST.bak"
    rm -f "$CONFIG$LIST_DNSMASQ.bak"
    # Notify user
    echo "${COLOR_GREEN}List updated!${COLOR_RESET}"
}

start() {
    update
    # Add List to host file
    cat "$CONFIG/$LIST" >> "$HOST_FILE"
    # Notify user
    echo "${COLOR_GREEN}ENABLED!${COLOR_RESET}"
}

stop() {
    # Remove list to host file
    custom-sed -i "/$START_TAG/,/$END_TAG/d" "$HOST_FILE"

    # Remove DNSMASQ
    cat /dev/null > "$CONFIG$LIST_DNSMASQ"

    # Notify user
    echo "${COLOR_GREEN}DISABLED!${COLOR_RESET}"
}

# PASO 3: Funciones de Autostart para macOS
autostart() {
    echo "Configurando el inicio automático (autostart)..."
    sudo mkdir -p /Library/LaunchDaemons
    cat << 'EOF' | sudo tee /Library/LaunchDaemons/com.maza.start.plist > /dev/null
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.maza.start</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/maza</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/maza.err</string>
    <key>StandardOutPath</key>
    <string>/tmp/maza.out</string>
</dict>
</plist>
EOF
    sudo chown root:wheel /Library/LaunchDaemons/com.maza.start.plist
    sudo chmod 644 /Library/LaunchDaemons/com.maza.start.plist
    sudo launchctl load -w /Library/LaunchDaemons/com.maza.start.plist
    echo "${COLOR_GREEN}¡Autostart habilitado y cargado correctamente!${COLOR_RESET}"
}

disableautostart() {
    echo "Deshabilitando el inicio automático (autostart)..."
    # Se descarga el servicio primero para evitar advertencias del sistema antes de borrar el archivo
    sudo launchctl unload -w /Library/LaunchDaemons/com.maza.start.plist 2>/dev/null || true
    sudo rm -f /Library/LaunchDaemons/com.maza.start.plist
    echo "${COLOR_GREEN}¡Autostart deshabilitado y eliminado correctamente!${COLOR_RESET}"
}

# CONTROLE ARGUMENTS
isArg=""

while [ $# -gt 0 ] ; do
    case "$1" in
    --help)
        usage
        ;;
    status)
        isArg="1"
        status
        ;;
    update)
        isArg="1"
        update
        ;;
    start)
        isArg="1"
        start
        ;;
    stop)
        isArg="1"
        stop
        ;;
    autostart)
        isArg="1"
        autostart
        ;;
    disableautostart)
        isArg="1"
        disableautostart
        ;;
    *)
        usage "Unknown option: $1"
        ;;
    esac
    shift
done

if [ -z "$isArg" ] ; then
    usage "Not enough arguments"
fi
